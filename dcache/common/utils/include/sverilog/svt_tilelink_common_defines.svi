always @(tilelink_master_if[ACTIVE_MASTER_VAL].c_source           ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].c_source     =  tilelink_master_if[ACTIVE_MASTER_VAL].c_source; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].c_address          ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].c_address    =  tilelink_master_if[ACTIVE_MASTER_VAL].c_address; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].c_data             ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].c_data       =  tilelink_master_if[ACTIVE_MASTER_VAL].c_data; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].c_corrupt          ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].c_corrupt    =  tilelink_master_if[ACTIVE_MASTER_VAL].c_corrupt; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].c_valid            ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].c_valid      =  tilelink_master_if[ACTIVE_MASTER_VAL].c_valid; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].e_sink             ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].e_sink       =  tilelink_master_if[ACTIVE_MASTER_VAL].e_sink;  \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].e_valid            ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].e_valid      =  tilelink_master_if[ACTIVE_MASTER_VAL].e_valid; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].b_ready            ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].b_ready      =  tilelink_master_if[ACTIVE_MASTER_VAL].b_ready; \
