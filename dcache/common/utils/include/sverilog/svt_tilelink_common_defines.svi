always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_opcode  ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_opcode              =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_opcode; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_param   ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_param               =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_param; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_size    ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_size                =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_size; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_source  ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_source              =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_source; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_sink    ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_sink                =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_sink; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_denied  ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_denied              =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_denied; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_data    ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_data                =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_data; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_corrupt ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_corrupt             =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_corrupt; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_valid   ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].d_valid               =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].d_valid; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].a_ready   ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].a_ready               =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].a_ready; \
always @(tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].c_ready   ) assign  tilelink_master_if[ACTIVE_MASTER_VAL].c_ready               =  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].c_ready; \
