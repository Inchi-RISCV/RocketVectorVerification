always @(tilelink_master_if[ACTIVE_MASTER_VAL].a_address          ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].a_address    =  tilelink_master_if[ACTIVE_MASTER_VAL].a_address; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].a_mask             ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].a_mask       =  tilelink_master_if[ACTIVE_MASTER_VAL].a_mask; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].a_data             ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].a_data       =  tilelink_master_if[ACTIVE_MASTER_VAL].a_data; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].a_corrupt          ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].a_corrupt    =  tilelink_master_if[ACTIVE_MASTER_VAL].a_corrupt; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].a_valid            ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].a_valid      =  tilelink_master_if[ACTIVE_MASTER_VAL].a_valid; \
always @(tilelink_master_if[ACTIVE_MASTER_VAL].c_opcode           ) assign  tilelink_cb_slave_agent_if[CROSSBAR_SLAVE_VAL].c_opcode     =  tilelink_master_if[ACTIVE_MASTER_VAL].c_opcode; \
