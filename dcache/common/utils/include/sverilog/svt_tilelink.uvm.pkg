`ifndef GUARD_SVT_TILELINK_UVM_PKG
`define GUARD_SVT_TILELINK_UVM_PKG

`ifdef DESIGNWARE_INCDIR
  `define SVT_TILELINK_LOADER_FILE `"`DESIGNWARE_INCDIR/vip/svt/common/latest/sverilog/include/svt_bootloader.svi`"
  `include `SVT_TILELINK_LOADER_FILE
  `include `SVT_SOURCE_MAP_LIB_INCLUDE_PKG(V-2024.03,svt.uvm)
  `include `SVT_SOURCE_MAP_LIB_INCLUDE_PKG(V-2024.03,svt_bfm_shell.uvm)
`else
  // If the svt.uvm.pkg file has already been loaded, then we must still
  // load svt_loader_util.svi so that the SVT_SOURCE_MAP_* macros can be defined correctly.
  `include "svt.uvm.pkg"
  `include "svt_bfm_shell.uvm.pkg"
`endif

`include "svt_tilelink_if.svi"
`include "svt_tilelink_master_if.svi"
`include "svt_tilelink_slave_if.svi"
`include "svt_tilelink_crossbar_if.svi"

package svt_tilelink_uvm_pkg;
  import uvm_pkg::*;
  `include "uvm_macros.svh"

  import svt_uvm_pkg::*;

`ifndef __SVDOC__
  typedef virtual svt_tilelink_if           svt_tilelink_vif; 
  typedef virtual svt_tilelink_master_if    svt_tilelink_master_vif; 
  typedef virtual svt_tilelink_slave_if     svt_tilelink_slave_vif; 
  typedef virtual svt_tilelink_crossbar_if  svt_tilelink_crossbar_vif; 
`endif

  `include `SVT_SOURCE_MAP_ENV_INCLUDE_SVI(tilelink_svt,tilelink_master_agent_svt,V-2024.03,svt_tilelink_master_agent_source.uvm)
  `include `SVT_SOURCE_MAP_ENV_INCLUDE_SVI(tilelink_svt,tilelink_slave_agent_svt,V-2024.03,svt_tilelink_slave_agent_source.uvm)
  `include `SVT_SOURCE_MAP_ENV_INCLUDE_SVI(tilelink_svt,tilelink_crossbar_agent_svt,V-2024.03,svt_tilelink_crossbar_agent_source.uvm)
  `include `SVT_SOURCE_MAP_ENV_INCLUDE_SVI(tilelink_svt,tilelink_system_env_svt,V-2024.03,svt_tilelink_system_env_source.uvm)

endpackage

`endif // GUARD_SVT_TILELINK_UVM_PKG

