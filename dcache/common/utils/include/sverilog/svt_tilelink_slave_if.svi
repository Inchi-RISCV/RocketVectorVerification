`ifndef GUARD_SVT_TILELINK_SLAVE_IF_SVI
`define GUARD_SVT_TILELINK_SLAVE_IF_SVI

`include "svt_tilelink_port_defines.svi"

typedef virtual svt_tilelink_slave_if svt_tilelink_slave_vif;

`define SVT_TILELINK_IF_SETUP_TIME 0
`define SVT_TILELINK_IF_HOLD_TIME  0
 
/**
 * This SystemVerilog 'interface' definition declares all of the signals
 * (scoped within an instance of this interface) that are specified by
 * the Tilelink Protocol Specification as being (potentially) included in
 * a Tilelink Master/Slave connection.
 */
interface svt_tilelink_slave_if (
  input logic tl_clock
);

  //----------------------------------------------------------------------------
  // Interface Ports
  // ---------------------------------------------------------------------------
  /** 
   * Bus reset(Global reset signal). Active HIGH. May be asserted asynchronously, but must be deasserted synchronous with a rising edge of clock. */
  logic  tl_reset;

  /**
   * Master In - Slave Out: This pin is used to transmit the Operation code. Identifies the type of message carried by the channel-A. */
  logic [(`SVT_TILELINK_A_OPCODE_WIDTH-1):0] a_opcode;

  /**
   * Master In - Slave Out: This pin is used to transmit the Parameter code. Meaning depends on a_opcode; specifies a transfer of caching permissions or a sub-opcode. */
  logic [(`SVT_TILELINK_A_PARAM_WIDTH-1):0] a_param;

  /**
   * Master In - Slave Out: This pin is used to transmit the Logarithm of the operation size: 2**n bytes. */
  logic [(`SVT_TILELINK_SIZE_WIDTH-1):0] a_size;

  /**
   * Master In - Slave Out: Unique, This pin refers per-link master source identifier. */
  logic [(`SVT_TILELINK_SOURCE_WIDTH-1):0] a_source;

  /**
   * Master In - Slave Out: This pin is used to transmit the target byte address of the operation. Must be aligned to a_size. */
  logic [(`SVT_TILELINK_ADDR_WIDTH-1):0] a_address;

  /**
   * Master In - Slave Out: This pin is used to transmit the Byte lane select for messages with data. */
  logic [(`SVT_TILELINK_DATA_WIDTH/8-1):0] a_mask;

  /**
   * Master In - Slave Out: This pin is used to transmit the Data payload for messages with data. */
  logic [(`SVT_TILELINK_DATA_WIDTH-1):0] a_data;

  /**
   * Master In - Slave Out: This pin is used to transmit the corrupt data beat. */
  logic  a_corrupt;

  /**
   * Master In - Slave Out: This pin is used by the sender offering progress on an operation. */
  logic  a_valid;

  /** 
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used to transmit the Operation code. Identifies the type of message carried by the channel-C. */
  logic [(`SVT_TILELINK_C_OPCODE_WIDTH-1):0] c_opcode;

  /** 
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used to transmit the Parameter code. Meaning depends on c_opcode; specifies a transfer of caching permissions. */
  logic [(`SVT_TILELINK_C_PARAM_WIDTH-1):0] c_param;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used to transmit the Logarithm of the operation size: 2**n bytes. */
  logic [(`SVT_TILELINK_SIZE_WIDTH-1):0] c_size;

  /** 
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: Unique, This pin refers per-link master source identifier. */
  logic [(`SVT_TILELINK_SOURCE_WIDTH-1):0] c_source;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used to transmit the target byte address of the operation. Must be aligned to c_size. */
  logic [(`SVT_TILELINK_ADDR_WIDTH-1):0] c_address;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used to transmit the Data payload for messages with data. */
  logic [(`SVT_TILELINK_DATA_WIDTH-1):0] c_data;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used to transmit the detected corrupted data beat. */
  logic  c_corrupt;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used by the sender offering progress on an operation. */
  logic  c_valid;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: Unique, This pin refers per-link slave sink identifier. */
  logic [(`SVT_TILELINK_SINK_WIDTH-1):0] e_sink;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used by the sender offering progress on an operation. */
  logic  e_valid;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master In - Slave Out: This pin is used by the receiver accepted the offered progress on an operation. */
  logic  b_ready;

  /** Master In - Slave Out: This pin is used by the receiver accepted the offered progress on an operation. */
  logic  d_ready;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used to transmit the Operation code. Identifies the type of message carried by the channel-B. */
  logic [(`SVT_TILELINK_B_OPCODE_WIDTH-1):0] b_opcode;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used to transmit the Parameter code. Meaning depends on b_opcode; specifies a transfer of caching permissions or a sub-opcode. */
  logic [(`SVT_TILELINK_B_PARAM_WIDTH-1):0] b_param;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used to transmit the Logarithm of the operation size: 2**n bytes. */
  logic [(`SVT_TILELINK_SIZE_WIDTH-1):0] b_size;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: Unique, This pin refers per-link master source identifier. */
  logic [(`SVT_TILELINK_SOURCE_WIDTH-1):0] b_source;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used to transmit the target byte address of the operation. Must be aligned to b_size. */
  logic [(`SVT_TILELINK_ADDR_WIDTH-1):0] b_address;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used to transmit the Byte lane select for messages with data. */
  logic [(`SVT_TILELINK_DATA_WIDTH/8-1):0] b_mask;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used to transmit the Data payload for messages with data. */
  logic [(`SVT_TILELINK_DATA_WIDTH-1):0] b_data;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used to transmit the corrupt data beat. */
  logic  b_corrupt;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used by the sender offering progress on an operation. */
  logic  b_valid;

  /**
   * Master Out - Slave In: This pin is used to transmit the Operation code. Identifies the type of message carried by the channel-D. */
  logic [(`SVT_TILELINK_D_OPCODE_WIDTH-1):0] d_opcode;

  /**
   * Master Out - Slave In: This pin is used to transmit the Parameter code. Meaning depends on d_opcode; specifies a transfer of caching permissions or a sub-opcode. */
  logic [(`SVT_TILELINK_D_PARAM_WIDTH-1):0] d_param;

  /**
   * Master Out - Slave In: This pin is used to transmit the Logarithm of the operation size: 2**n bytes. */
  logic [(`SVT_TILELINK_SIZE_WIDTH-1):0] d_size;

  /**
   * Master Out - Slave In: Unique, This pin refers per-link master source identifier. */
  logic [(`SVT_TILELINK_SOURCE_WIDTH-1):0] d_source;

  /**
   * Master Out - Slave In: Unique, This pin refers per-link slave sink identifier. */
  logic [(`SVT_TILELINK_SINK_WIDTH-1):0] d_sink;

  /**
   * Master Out - Slave In: This pin refers that the slave was unable to service the request. */
  logic  d_denied;

  /**
   * Master Out - Slave In: This pin is used to transmit the Data payload for messages with data. */
  logic [(`SVT_TILELINK_DATA_WIDTH-1):0] d_data;

  /**
   * Master Out - Slave In: This pin is used to transmit the corrupt data beat. */
  logic  d_corrupt;

  /**
   * Master Out - Slave In: This pin is used by the sender offering progress on an operation. */
  logic  d_valid;

  /**
   * Master Out - Slave In: This pin is used by the receiver accepted the offered progress on an operation. */
  logic  a_ready;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used by the receiver accepted the offered progress on an operation. */
  logic  c_ready;

  /**
   * <b> NOTE: THIS FEATURE IS NOT SUPPORTED FOR THIS RELEASE. </b> <br>
   * Master Out - Slave In: This pin is used by the receiver accepted the offered progress on an operation. */
  logic  e_ready;


  logic [3:0] bus_id;

  //----------------------------------------------------------------------------
  // Internal assign
  // ---------------------------------------------------------------------------
  event event_enter_dvalid_assert, event_enter_dvalid_wait_state, event_enter_dvalid_outstanding_state, event_enter_dvalid_asserted_state, event_enter_resp_idle_state,event_dyn_reset_deasserted,event_sort_resp_queue_for_resp,event_calc_dvalid_delay,resp_queue_populated,aligned_addr,single_beat_txn,multi_beat_txn,valid_ready_asserted;
  event event_enter_aready_wait_state,event_enter_aready_ready_state,event_enter_cready_wait_state,event_enter_cready_ready_state,event_enter_eready_wait_state,event_enter_eready_ready_state;
  event event_enter_bvalid_assert,event_enter_bvalid_wait_state,event_enter_bvalid_asserted_state,event_calc_bvalid_delay;
  event event_cfg_a_valid_a_ready_delay_accounted,event_cfg_a_ready_a_ready_delay_accounted,event_cfg_a_ready_deassert_delay_accounted,event_aready_aready_delay_check,event_avalid_aready_delay_check,event_aready_deassert_delay_check,trigger1,trigger2,trigger3,trigger4,trigger5,trigger6,trigger7,trigger8,resp_queue_item_deleted;
  event event_aready_delay_value_configured, event_avalid_aready_delay_value_configured, event_aready_aready_delay_value_configured, event_aready_deassert_delay_value_configured;
  event event_cfg_c_ready_c_ready_delay_accounted,event_cfg_c_valid_c_ready_delay_accounted,event_cfg_c_ready_deassert_delay_accounted,event_cready_cready_delay_check,event_cvalid_cready_delay_check,event_cready_deassert_delay_check;
  event event_cready_delay_value_configured, event_cvalid_cready_delay_value_configured, event_cready_cready_delay_value_configured, event_cready_deassert_delay_value_configured;
  event event_cfg_e_ready_e_ready_delay_accounted,event_cfg_e_valid_e_ready_delay_accounted,event_cfg_e_ready_deassert_delay_accounted,event_eready_eready_delay_check,event_evalid_eready_delay_check,event_eready_deassert_delay_check;
  event event_eready_delay_value_configured, event_evalid_eready_delay_value_configured, event_eready_eready_delay_value_configured, event_eready_deassert_delay_value_configured;
  event event_forward_txn_dvalid_delay_accounted,event_reverse_txn_dvalid_delay_accounted,event_forward_txn_crss_chnl_dvalid_delay_accounted,event_reverse_txn_crss_chnl_dvalid_delay_accounted,event_forward_cfg_dvalid_delay_accounted,event_reverse_cfg_dvalid_delay_accounted,event_forward_cfg_crss_chnl_dvalid_delay_accounted,event_reverse_cfg_crss_chnl_dvalid_delay_accounted;
  event event_channel_a_sampling_starts,event_st_out_xact_created,event_channel_d_sampling_starts,event_rx_object,event_piped_dvalid_assert_sampled,cb_slave_resp_detected,event_channel_b_sampling_starts,event_channel_c_sampling_starts,event_channel_e_sampling_starts;
  int current_dvalid_beat,cfg_a_valid_a_ready_delay,cfg_a_ready_a_ready_delay,cfg_a_ready_deassert_delay,cfg_dvalid_delay,crss_chnl_delay,resp_index,ot_index,beat_count,beat_count_c,txn_count,txn_count_to_cb,resp_count,region_resp_crss_chnl_delay,region_resp_d_valid_delay,object_num_chnl_a,object_num_chnl_c,object_num_chnl_d,chnl_a_beat,chnl_c_beat,chnl_d_beat,cb_response_rcvd;
  int cfg_c_ready_c_ready_delay,cfg_c_valid_c_ready_delay,cfg_c_ready_deassert_delay;
  int chnl_b_beat,object_num_chnl_b;
  int cfg_e_ready_e_ready_delay,cfg_e_valid_e_ready_delay,cfg_e_ready_deassert_delay,current_bvalid_beat,cfg_bvalid_delay;
  bit calc_d_valid_delay,sort_resp_queue_for_resp,resp_sort_delay_lapse,d_valid_delay_lapse,complete_response_driven,complete_response_driven_for_release,outstanding_timeout_flag,addr_outside_fifo_range;
  bit calc_b_valid_delay;
  bit cb_d_ready_control,slv_a_ready_control;
  bit slv_e_ready_control;
  bit slv_c_ready_control;
  logic[31:0] clk_cnt;
  bit drive_chnl_A_or_C;


  //----------------------------------------------------------------------------
  // Initial Blockn
  // ---------------------------------------------------------------------------
  initial begin
    b_opcode   = 'hz;
    b_param    = 'hz;
    b_size     = 'hz;
    b_source   = 'hz;
    b_address  = 'hz;
    b_mask     = 'hz;
    b_data     = 'hz;
    b_corrupt  = 'hz;
    b_valid    = 'hz;
    d_opcode   = 'hz;
    d_param    = 'hz;
    d_size     = 'hz;
    d_source   = 'hz;
    d_sink     = 'hz;
    d_denied   = 'hz;
    d_data     = 'hz;
    d_corrupt  = 'hz;
    d_valid    = 'hz;
    a_ready    = 'hz;
    c_ready    = 'hz;
    e_ready    = 'hz;
  end

  //----------------------------------------------------------------------------
  // Clocking Block
  // ---------------------------------------------------------------------------
  /** Clocking block for Tilelink salve */
  clocking tilelink_master_cb @( posedge tl_clock);
    default input  #`SVT_TILELINK_MONITOR_IF_SETUP_TIME
            output #`SVT_TILELINK_MONITOR_IF_HOLD_TIME;
    input  tl_reset;
    input  a_opcode;
    input  a_param;
    input  a_size;
    input  a_source;
    input  a_address;
    input  a_mask;
    input  a_data;
    input  a_corrupt;
    input  a_valid;
    input  c_opcode;
    input  c_param;
    input  c_size;
    input  c_source;
    input  c_address;
    input  c_data;
    input  c_corrupt;
    input  c_valid;
    input  e_sink;
    input  e_valid;
    input  b_ready;
    input  d_ready;
    output b_opcode;
    output b_param;
    output b_size;
    output b_source;
    output b_address;
    output b_mask;
    output b_data;
    output b_corrupt;
    output b_valid;
    output d_opcode;
    output d_param;
    output d_size;
    output d_source;
    output d_sink;
    output d_denied;
    output d_data;
    output d_corrupt;
    output d_valid;
    output a_ready;
    output c_ready;
    output e_ready;
  endclocking : tilelink_master_cb

  /** Clocking block for Tilelink salve */
  clocking tilelink_slave_cb @( posedge tl_clock);
    default input  #`SVT_TILELINK_MONITOR_IF_SETUP_TIME
            output #`SVT_TILELINK_MONITOR_IF_HOLD_TIME;
    output tl_reset;
    output a_opcode;
    output a_param;
    output a_size;
    output a_source;
    output a_address;
    output a_mask;
    output a_data;
    output a_corrupt;
    output a_valid;
    output c_opcode;
    output c_param;
    output c_size;
    output c_source;
    output c_address;
    output c_data;
    output c_corrupt;
    output c_valid;
    output e_sink;
    output e_valid;
    output b_ready;
    output d_ready;
    input  b_opcode;
    input  b_param;
    input  b_size;
    input  b_source;
    input  b_address;
    input  b_mask;
    input  b_data;
    input  b_corrupt;
    input  b_valid;
    input  d_opcode;
    input  d_param;
    input  d_size;
    input  d_source;
    input  d_sink;
    input  d_denied;
    input  d_data;
    input  d_corrupt;
    input  d_valid;
    input  a_ready;
    input  c_ready;
    input  e_ready;
  endclocking : tilelink_slave_cb

  /** Clocking block for Tilelink salve */
  clocking tilelink_master_slave_monitor_cb @( posedge tl_clock);
    default input  #`SVT_TILELINK_MONITOR_IF_SETUP_TIME
            output #`SVT_TILELINK_MONITOR_IF_HOLD_TIME;
    input tl_reset;
    input a_opcode;
    input a_param;
    input a_size;
    input a_source;
    input a_address;
    input a_mask;
    input a_data;
    input a_corrupt;
    input a_valid;
    input c_opcode;
    input c_param;
    input c_size;
    input c_source;
    input c_address;
    input c_data;
    input c_corrupt;
    input c_valid;
    input e_sink;
    input e_valid;
    input b_ready;
    input d_ready;
    input b_opcode;
    input b_param;
    input b_size;
    input b_source;
    input b_address;
    input b_mask;
    input b_data;
    input b_corrupt;
    input b_valid;
    input d_opcode;
    input d_param;
    input d_size;
    input d_source;
    input d_sink;
    input d_denied;
    input d_data;
    input d_corrupt;
    input d_valid;
    input a_ready;
    input c_ready;
    input e_ready;
  endclocking : tilelink_master_slave_monitor_cb

  /** Clocking block for Tilelink salve */
  clocking tilelink_master_slave_debug_cb @( posedge tl_clock);
    default input  #`SVT_TILELINK_MONITOR_IF_SETUP_TIME
            output #`SVT_TILELINK_MONITOR_IF_HOLD_TIME;
    inout tl_reset;
    inout a_opcode;
    inout a_param;
    inout a_size;
    inout a_source;
    inout a_address;
    inout a_mask;
    inout a_data;
    inout a_corrupt;
    inout a_valid;
    inout c_opcode;
    inout c_param;
    inout c_size;
    inout c_source;
    inout c_address;
    inout c_data;
    inout c_corrupt;
    inout c_valid;
    inout e_sink;
    inout e_valid;
    inout b_ready;
    inout d_ready;
    inout b_opcode;
    inout b_param;
    inout b_size;
    inout b_source;
    inout b_address;
    inout b_mask;
    inout b_data;
    inout b_corrupt;
    inout b_valid;
    inout d_opcode;
    inout d_param;
    inout d_size;
    inout d_source;
    inout d_sink;
    inout d_denied;
    inout d_data;
    inout d_corrupt;
    inout d_valid;
    inout a_ready;
    inout c_ready;
    inout e_ready;
  endclocking : tilelink_master_slave_debug_cb

  //----------------------------------------------------------------------------
  // Modports
  //----------------------------------------------------------------------------
  modport svt_tilelink_master_modport (clocking tilelink_master_cb);
  modport svt_tilelink_slave_modport (clocking tilelink_slave_cb);
  modport svt_tilelink_master_slave_monitor_modport (clocking tilelink_master_slave_monitor_cb);
  modport svt_tilelink_master_slave_debug_modport (clocking tilelink_master_slave_debug_cb);
  

endinterface: svt_tilelink_slave_if 

`endif // GUARD_SVT_TILELINK_SLAVE_IF_SVI
