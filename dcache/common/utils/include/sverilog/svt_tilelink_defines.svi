// DESCRIPTION: This file is simply a convenience to allow the inclusion of both
// the common define symbols, and the port define symbols, from a single file.
// Also there is a `include to read in any user-overrides defined in a
// user-specified file, whose path has been assigned to the `SVT_TILELINK_USER_DEFINES
// symbol.

`ifndef GUARD_SVT_TILELINK_DEFINES_SVI
`define GUARD_SVT_TILELINK_DEFINES_SVI

`ifndef SVT_TILELINK_VERSION
`define SVT_TILELINK_VERSION V-2024.03
`endif

// First read in the user-specified defines (if any), that may take precedence
// over some of the following defaults...
`ifdef SVT_TILELINK_INCLUDE_USER_DEFINES
`include "svt_tilelink_user_defines.svi"
`endif // SVT_TILELINK_INCLUDE_USER_DEFINES

// Read in the symbolic constants that control signal widths.
`include "svt_tilelink_port_defines.svi"

// Read in the symbolic constants for common values used by the OCP VIP.
`include "svt_tilelink_common_defines.svi"

`endif // GUARD_SVT_TILELINK_DEFINES_SVI
