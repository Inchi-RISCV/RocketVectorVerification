
`ifndef GUARD_TILELINK_RESET_IF_SVI
`define GUARD_TILELINK_RESET_IF_SVI

/**
 * Abstract:
 * Defines an interface that provides access to a reset signal.  This
 * interface can be used to write sequences to drive the reset logic.
 */
interface tilelink_reset_if();

  logic reset;
  logic clk;

  modport tilelink_reset_modport (input clk, output reset);

endinterface

`endif // GUARD_TILELINK_RESET_IF_SVI

